# ─── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ─── Admin (required) ─────────────────────────────────────────────────────────
# Comma-separated list of emails that automatically get Owner/Admin role
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ─── Optional ─────────────────────────────────────────────────────────────────
VITE_DISCORD_GUILD_ID=your_discord_server_guild_id
