# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it is gitignored.

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Found at: Supabase Dashboard → Project Settings → Data API → anon (public) key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ─── Admin (required) ─────────────────────────────────────────────────────────
# The email that automatically gets Owner/Admin role on login
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ─── Optional ─────────────────────────────────────────────────────────────────
# Your Discord server's Guild ID (right-click server → Copy Server ID)
VITE_DISCORD_GUILD_ID=your_discord_server_guild_id
